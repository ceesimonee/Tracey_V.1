# Preserve annotations, Kotlin metadata, and reflection signatures
-keepattributes Signature,RuntimeVisibleAnnotations,AnnotationDefault
-keep class kotlin.Metadata { *; }

# Keep Room databases, DAOs, and entities
-keep class * extends androidx.room.RoomDatabase {
    <init>();
    *;
}
-keep @androidx.room.Entity class * {
    <init>(...);
    *;
}
-keepclassmembers class * {
    @androidx.room.* <methods>;
}

# Keep Tracey application entry point, ViewModel, and data models
-keep class com.example.tracey.MainActivity { *; }
-keep class com.example.tracey.viewmodel.** { *; }
-keep class com.example.tracey.data.** { *; }

# Keep Google ML Kit text recognition classes
-keep class com.google.mlkit.** { *; }
-keep class com.google.android.gms.internal.mlkit_vision_text_common.** { *; }
-dontwarn com.google.mlkit.**
-dontwarn com.google.android.gms.internal.mlkit_vision_text_common.**